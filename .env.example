# ---------------------------------------------------------------------------
# JJ Furniture OMS — copy to .env.local (never commit real values)
# ---------------------------------------------------------------------------

# "demo"       = role-switcher bar, Design Notes, Reset Demo Data (usability testing)
# "production" = Supabase Auth sign-in only; role switcher is not rendered
NEXT_PUBLIC_APP_MODE=demo

# Supabase project (Settings → API). Leave empty in demo mode to use the
# built-in in-memory sample data instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used for review links, order details after RLS confirmed ownership,
# and narrowly scoped workflow writes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters; signs demo sessions, review sessions and demo customer logins,
# and keys the HMAC used for privacy-preserving rate-limit buckets (no raw emails stored).
# Required in production. Generate: openssl rand -hex 32
JJ_SESSION_SECRET=

# Public base URL printed on slips / SMS (e.g. https://jj-oms.vercel.app)
NEXT_PUBLIC_SITE_URL=

# How many days a shop quotation stays valid before the customer must ask for
# a fresh one (default 7, clamped 1–90).
QUOTE_VALIDITY_DAYS=7

# ----------------------------------------------------------------------------
# Transactional email (quotation review links, order confirmations, password
# set-up links). SERVER ONLY — never prefix any of these with NEXT_PUBLIC_.
# Emails are queued in notification_outbox and sent by the server; "sent" means
# ACCEPTED by the provider (not guaranteed inbox delivery). With no provider,
# demo mode renders them in the Demo Inbox; production keeps them "pending".
#
# Option 1 (recommended): Resend — https://resend.com
#   Verify your sending domain in Resend and publish its SPF (TXT), DKIM (CNAME)
#   and DMARC (TXT, e.g. "v=DMARC1; p=quarantine; rua=mailto:dmarc@your-domain")
#   records so Gmail and others accept the mail.
RESEND_API_KEY=
EMAIL_FROM="JJ Furniture <orders@your-domain.example>"
#
# Option 2: Gmail SMTP (smtp.gmail.com:465, TLS). Prerequisites: turn on 2-Step
#   Verification for the Google Account, then create a 16-character App Password
#   (Google Account → Security → App passwords). Mail is sent FROM this address
#   (or a verified Gmail alias). Gmail limits daily volume; use Resend for scale.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Display name used with Gmail SMTP (default "JJ Furniture").
EMAIL_FROM_NAME=JJ Furniture
#
# Secrets waiting in the outbox (review tokens, set-up links) are encrypted with
# AES-256-GCM. Base64 of EXACTLY 32 random bytes. REQUIRED in production — the
# app refuses to queue secrets without it (no plaintext fallback).
#   Generate:  openssl rand -base64 32
OUTBOX_TOKEN_ENCRYPTION_KEY=
# Key rotation: put the NEW key above and the old one(s) here (comma-separated,
# base64) until every pending row encrypted with them has been sent or expired.
OUTBOX_TOKEN_ENCRYPTION_KEYS_PREVIOUS=
#
# Queue worker: POST /api/notifications/process with
#   Authorization: Bearer <CRON_SECRET>
# every minute or two from your scheduler (Supabase pg_cron + pg_net, GitHub
# Actions, or any cron service). 32+ random characters; unset = worker disabled.
#   Generate:  openssl rand -hex 32
CRON_SECRET=
#
# Number of proxies in front of the app that APPEND to X-Forwarded-For (default 1,
# e.g. Vercel). The client IP for rate limits is read that many entries from the
# right, so a client cannot spoof it by sending its own X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Single-use quotation review link lifetime in hours (default 72, 1–336).
REVIEW_LINK_TTL_HOURS=72

# Optional: Semaphore (semaphore.co) SMS gateway. Without it, production logs
# messages as "Pending" for staff to send by Messenger; demo mode simulates.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Seeding a DEMO Supabase project (npm run db:seed)
SEED_STAFF_PASSWORD=
SEED_EMAIL_DOMAIN=jjfurniture.test
